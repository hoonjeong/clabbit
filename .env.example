# ==============================================
# 클래빗(Clabbit) 학원 관리 시스템 환경 설정
# ==============================================
# 이 파일을 .env로 복사한 후 실제 값으로 수정하세요
# cp .env.example .env

# Application
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=clabbit

# Session Secret (프로덕션에서 반드시 변경하세요!)
# 보안: 최소 32자 이상의 랜덤 문자열을 사용하세요
# 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-secret-key-change-this-in-production-minimum-32-characters

# JWT Configuration (Optional)
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Email Configuration (For billing notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_FROM_NAME=클래빗 알림
MAIL_FROM_EMAIL=noreply@clabbit.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Logging Level
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Billing System Configuration
# Encryption key for sensitive data (bank accounts)
# 보안: 반드시 32자의 랜덤 문자열을 사용하세요
# 생성 예시: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# 경고: 이 키를 변경하면 기존 암호화된 데이터를 복호화할 수 없습니다!
ENCRYPTION_KEY=your-encryption-key-exactly-32-characters

# SMS Configuration (Optional - for payment notifications)
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
SMS_SENDER_NUMBER=your-sender-phone-number

# Kakao Alimtalk Configuration (Optional - for Korean messaging)
KAKAO_API_KEY=your-kakao-api-key
KAKAO_SENDER_KEY=your-kakao-sender-key
KAKAO_TEMPLATE_CODE=your-template-code

# PDF Generation Settings
PDF_LOGO_PATH=public/image/logo.png
PDF_WATERMARK_TEXT=COPY

# AI Integration
# Google Gemini API Key (Required for AI features)
GEMINI_API_KEY=your-gemini-api-key-here
# Get your API key from: https://makersuite.google.com/app/apikey

# Scheduler Settings
ENABLE_SCHEDULER=true
SCHEDULER_TIME_ZONE=Asia/Seoul
DAILY_CHARGE_TIME=09:00
WEEKLY_REMINDER_DAY=5
MONTHLY_CHARGE_DAY=1