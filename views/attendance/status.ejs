<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/design-system.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .attendance-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px;
        }

        .page-header {
            margin-bottom: 32px;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
            color: #333;
            margin-bottom: 8px;
        }

        .page-header p {
            color: #666;
            font-size: 14px;
        }

        /* 필터 섹션 */
        .filter-section {
            background: white;
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            margin-bottom: 24px;
        }

        .filter-row {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .filter-group {
            flex: 1;
        }

        .filter-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

        .filter-group select,
        .filter-group input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 14px;
            color: #333;
        }

        .btn-search {
            padding: 10px 24px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .btn-search:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

        /* 출석 현황 테이블 */
        .attendance-table-section {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .section-header {
            padding: 20px 24px;
            border-bottom: 1px solid #f0f0f0;
        }

        .section-header h2 {
            font-size: 18px;
            font-weight: 600;
            color: #333;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        .attendance-table {
            width: 100%;
            border-collapse: collapse;
        }

        .attendance-table th {
            background: #f8f9fa;
            padding: 12px 16px;
            text-align: left;
            font-size: 13px;
            font-weight: 600;
            color: #666;
            border-bottom: 1px solid #e0e0e0;
        }

        .attendance-table td {
            padding: 14px 16px;
            font-size: 14px;
            color: #333;
            border-bottom: 1px solid #f0f0f0;
        }

        .attendance-table tbody tr:hover {
            background: #f8f9fa;
        }

        /* 출석 상태 뱃지 */
        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .status-badge.present { background: #d4edda; color: #155724; }
        .status-badge.absent { background: #f8d7da; color: #721c24; }
        .status-badge.late { background: #fff3cd; color: #856404; }
        .status-badge.early { background: #ffe4b5; color: #ff6600; }
        .status-badge.sick { background: #e2e3e5; color: #383d41; }
        .status-badge.official { background: #d1ecf1; color: #0c5460; }

        /* 빈 상태 */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }

        .empty-state svg {
            width: 64px;
            height: 64px;
            margin-bottom: 16px;
            opacity: 0.3;
        }

        .loading-state {
            text-align: center;
            padding: 40px;
            color: #666;
        }

        /* 캘린더 뷰 */
        .calendar-view {
            display: none;
            padding: 24px;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 1px;
            background: #e0e0e0;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
        }

        .calendar-day {
            background: white;
            padding: 8px;
            min-height: 80px;
        }

        .calendar-day-header {
            background: #f8f9fa;
            padding: 12px;
            text-align: center;
            font-weight: 600;
            color: #666;
        }

        .calendar-date {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .calendar-attendance {
            display: flex;
            flex-wrap: wrap;
            gap: 2px;
            font-size: 11px;
        }

        .view-toggle {
            display: flex;
            gap: 8px;
            margin-bottom: 20px;
        }

        .view-btn {
            padding: 8px 16px;
            border: 1px solid #e0e0e0;
            background: white;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }

        .view-btn.active {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }
    </style>
</head>
<body>
    <%- include('../components/sidebar-menu', { academyName, page, userName }) %>

    <div class="attendance-container">
        <div class="page-header">
            <h1>📊 출석 현황 조회</h1>
            <p>월별 출석 현황을 조회하고 관리하세요</p>
        </div>

        <!-- 필터 섹션 -->
        <div class="filter-section">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="monthSelect">조회 년월</label>
                    <input type="month" id="monthSelect" />
                </div>
                <div class="filter-group">
                    <label for="classSelect">수업</label>
                    <select id="classSelect">
                        <option value="">전체</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="studentSearch">학생 검색</label>
                    <input type="text" id="studentSearch" placeholder="학생 이름으로 검색" />
                </div>
                <div class="filter-group" style="flex: 0; padding-top: 24px;">
                    <button class="btn-search" onclick="loadAttendance()">조회</button>
                </div>
            </div>
        </div>

        <!-- 뷰 전환 -->
        <div class="view-toggle">
            <button class="view-btn active" onclick="toggleView('list')">목록 보기</button>
            <button class="view-btn" onclick="toggleView('calendar')">캘린더 보기</button>
        </div>

        <!-- 출석 현황 테이블 -->
        <div class="attendance-table-section" id="listView">
            <div class="section-header">
                <h2>출석 현황</h2>
            </div>
            <div class="table-wrapper">
                <table class="attendance-table" id="attendanceTable">
                    <thead>
                        <tr>
                            <th>날짜</th>
                            <th>요일</th>
                            <th>학생명</th>
                            <th>학년</th>
                            <th>수업명</th>
                            <th>출석 상태</th>
                            <th>체크인</th>
                            <th>체크아웃</th>
                            <th>비고</th>
                        </tr>
                    </thead>
                    <tbody id="attendanceBody">
                        <tr>
                            <td colspan="9" class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                                </svg>
                                <p>조회 조건을 선택하고 조회 버튼을 클릭하세요</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 캘린더 뷰 -->
        <div class="attendance-table-section calendar-view" id="calendarView">
            <div class="section-header">
                <h2>월별 출석 캘린더</h2>
            </div>
            <div id="calendarContent"></div>
        </div>
    </div>

    <script>
        let currentView = 'list';
        let attendanceData = [];

        document.addEventListener('DOMContentLoaded', async function() {
            // 현재 월로 초기화
            const today = new Date();
            const yearMonth = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0');
            document.getElementById('monthSelect').value = yearMonth;

            // 수업 목록 로드
            await loadClasses();
        });

        // 수업 목록 로드
        async function loadClasses() {
            try {
                const response = await fetch('/api/attendance/classes');
                const data = await response.json();

                if (data.success && data.classes) {
                    const select = document.getElementById('classSelect');
                    select.innerHTML = '<option value="">전체</option>';

                    data.classes.forEach(cls => {
                        const option = document.createElement('option');
                        option.value = cls.id;
                        option.textContent = `${cls.class_name} (${cls.teacher_name || '강사 미지정'})`;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('수업 목록 로드 오류:', error);
            }
        }

        // 출석 현황 조회
        async function loadAttendance() {
            const month = document.getElementById('monthSelect').value;
            const classId = document.getElementById('classSelect').value;
            const studentName = document.getElementById('studentSearch').value;

            if (!month) {
                alert('조회할 년월을 선택해주세요.');
                return;
            }

            try {
                let url = `/api/attendance/monthly?month=${month}`;
                if (classId) url += `&class_id=${classId}`;
                if (studentName) url += `&student_name=${encodeURIComponent(studentName)}`;

                const response = await fetch(url);
                const data = await response.json();

                if (data.success) {
                    attendanceData = data.attendance;
                    displayAttendance(data.attendance);

                    if (currentView === 'calendar') {
                        displayCalendar(data.attendance, month);
                    }
                } else {
                    alert(data.error || '출석 현황을 불러오는 중 오류가 발생했습니다.');
                }
            } catch (error) {
                console.error('출석 현황 조회 오류:', error);
                alert('출석 현황을 불러오는 중 오류가 발생했습니다.');
            }
        }

        // 출석 현황 표시 (목록)
        function displayAttendance(attendance) {
            const tbody = document.getElementById('attendanceBody');

            if (attendance.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="empty-state">
                            <p>조회된 출석 기록이 없습니다</p>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = attendance.map(record => {
                const date = new Date(record.attendance_date);
                const dayOfWeek = ['일', '월', '화', '수', '목', '금', '토'][date.getDay()];
                const dateStr = date.toLocaleDateString('ko-KR');

                return `
                    <tr>
                        <td>${dateStr}</td>
                        <td>${dayOfWeek}요일</td>
                        <td>${record.student_name}</td>
                        <td>${record.grade || '-'}</td>
                        <td>${record.class_name}</td>
                        <td>
                            <span class="status-badge ${getStatusClass(record.status)}">
                                ${record.status}
                            </span>
                        </td>
                        <td>${record.check_in_time || '-'}</td>
                        <td>${record.check_out_time || '-'}</td>
                        <td>${record.note || '-'}</td>
                    </tr>
                `;
            }).join('');
        }

        // 캘린더 표시
        function displayCalendar(attendance, yearMonth) {
            const [year, month] = yearMonth.split('-').map(Number);
            const firstDay = new Date(year, month - 1, 1);
            const lastDay = new Date(year, month, 0);
            const startDayOfWeek = firstDay.getDay();

            // 날짜별로 출석 데이터 그룹화
            const attendanceByDate = {};
            attendance.forEach(record => {
                const dateStr = record.attendance_date.split('T')[0];
                if (!attendanceByDate[dateStr]) {
                    attendanceByDate[dateStr] = [];
                }
                attendanceByDate[dateStr].push(record);
            });

            let html = '<div class="calendar-grid">';

            // 요일 헤더
            const daysOfWeek = ['일', '월', '화', '수', '목', '금', '토'];
            daysOfWeek.forEach(day => {
                html += `<div class="calendar-day-header">${day}</div>`;
            });

            // 빈 칸 채우기
            for (let i = 0; i < startDayOfWeek; i++) {
                html += '<div class="calendar-day" style="background: #fafafa;"></div>';
            }

            // 날짜 칸
            for (let date = 1; date <= lastDay.getDate(); date++) {
                const dateStr = `${year}-${String(month).padStart(2, '0')}-${String(date).padStart(2, '0')}`;
                const dayAttendance = attendanceByDate[dateStr] || [];

                html += `
                    <div class="calendar-day">
                        <div class="calendar-date">${date}</div>
                        <div class="calendar-attendance">
                `;

                if (dayAttendance.length > 0) {
                    const stats = getAttendanceStats(dayAttendance);
                    if (stats.출석 > 0) html += `<span class="status-badge present">출석 ${stats.출석}</span>`;
                    if (stats.결석 > 0) html += `<span class="status-badge absent">결석 ${stats.결석}</span>`;
                    if (stats.지각 > 0) html += `<span class="status-badge late">지각 ${stats.지각}</span>`;
                    if (stats.조퇴 > 0) html += `<span class="status-badge early">조퇴 ${stats.조퇴}</span>`;
                }

                html += `
                        </div>
                    </div>
                `;
            }

            html += '</div>';

            document.getElementById('calendarContent').innerHTML = html;
        }

        // 출석 통계 계산
        function getAttendanceStats(records) {
            const stats = {
                '출석': 0,
                '결석': 0,
                '지각': 0,
                '조퇴': 0,
                '병결': 0,
                '공결': 0
            };

            records.forEach(record => {
                if (stats[record.status] !== undefined) {
                    stats[record.status]++;
                }
            });

            return stats;
        }

        // 상태별 클래스 반환
        function getStatusClass(status) {
            const statusMap = {
                '출석': 'present',
                '결석': 'absent',
                '지각': 'late',
                '조퇴': 'early',
                '병결': 'sick',
                '공결': 'official'
            };
            return statusMap[status] || '';
        }

        // 뷰 전환
        function toggleView(view) {
            currentView = view;

            // 버튼 활성화 상태 변경
            document.querySelectorAll('.view-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');

            // 뷰 전환
            if (view === 'list') {
                document.getElementById('listView').style.display = 'block';
                document.getElementById('calendarView').style.display = 'none';
            } else {
                document.getElementById('listView').style.display = 'none';
                document.getElementById('calendarView').style.display = 'block';

                // 캘린더 뷰로 전환 시 캘린더 다시 그리기
                if (attendanceData.length > 0) {
                    const month = document.getElementById('monthSelect').value;
                    displayCalendar(attendanceData, month);
                }
            }
        }
    </script>
</body>
</html>