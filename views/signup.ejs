<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <meta name="description" content="클래빗 회원가입 - 학원 관리의 새로운 시작">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/form.css">
</head>
<body>
    <div class="form-container-center">
        <div class="form-container">
            <div class="form-header">
                <h1 class="form-title">클래빗 회원가입</h1>
                <p class="form-subtitle">학원 성장의 첫 걸음을 시작하세요</p>
            </div>

            <form id="signupForm">
                <div class="form-group">
                    <label for="name" class="form-label form-label-required">이름</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        class="form-input"
                        placeholder="홍길동"
                        required
                        autofocus
                    >
                </div>

                <div class="form-group">
                    <label for="email" class="form-label form-label-required">이메일</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-input"
                        placeholder="example@email.com"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="phone" class="form-label">연락처</label>
                    <input
                        type="tel"
                        id="phone"
                        name="phone"
                        class="form-input"
                        placeholder="010-1234-5678"
                    >
                    <span class="form-help-text">선택사항입니다</span>
                </div>

                <div class="form-group">
                    <label for="password" class="form-label form-label-required">비밀번호</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-input"
                        placeholder="비밀번호를 입력하세요"
                        minlength="6"
                        required
                    >
                    <span class="form-help-text">최소 6자 이상 입력해주세요</span>
                </div>

                <div class="form-group">
                    <label for="confirmPassword" class="form-label form-label-required">비밀번호 확인</label>
                    <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        class="form-input"
                        placeholder="비밀번호를 다시 입력하세요"
                        required
                    >
                </div>

                <button type="submit" class="form-btn form-btn-primary form-btn-block">
                    회원가입하기
                </button>
            </form>

            <div class="form-footer">
                <p class="form-footer-text">
                    이미 계정이 있으신가요?
                    <a href="/login" class="form-link">로그인하기</a>
                </p>
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
    <script src="/js/auth.js"></script>
</body>
</html>
