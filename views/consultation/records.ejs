<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 클래빗</title>
  <link rel="stylesheet" href="/css/design-system.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/consultation.css">
</head>
<body>
  <%- include('../components/sidebar-menu', { academyName, page, userName }) %>

  <div class="container">
    <div class="content-header">
      <h1>상담 관리</h1>
      <button id="btnAddConsultation" class="btn btn-primary">
        <i class="fas fa-plus"></i> 상담 추가
      </button>
    </div>

    <!-- 필터 영역 -->
    <div class="filter-section">
      <div class="filter-group">
        <label>학생 검색</label>
        <input type="text" id="filterStudent" class="form-control" placeholder="학생명 입력">
      </div>
      <div class="filter-group">
        <label>상담 분류</label>
        <select id="filterCategory" class="form-control">
          <option value="">전체</option>
          <!-- 동적으로 생성됨 -->
        </select>
      </div>
      <div class="filter-group">
        <label>상담자</label>
        <select id="filterConsultant" class="form-control">
          <option value="">전체</option>
          <!-- 동적으로 생성됨 -->
        </select>
      </div>
      <div class="filter-group">
        <label>날짜 범위</label>
        <div class="date-range">
          <input type="date" id="filterFromDate" class="form-control">
          <span>~</span>
          <input type="date" id="filterToDate" class="form-control">
        </div>
      </div>
      <div class="filter-group">
        <label>&nbsp;</label>
        <div>
          <label class="checkbox-label">
            <input type="checkbox" id="filterImportant"> 중요 상담만
          </label>
          <label class="checkbox-label">
            <input type="checkbox" id="filterFollowUp"> 추가 상담 필요
          </label>
        </div>
      </div>
      <button id="btnSearch" class="btn btn-secondary">
        <i class="fas fa-search"></i> 검색
      </button>
    </div>

    <!-- 상담 목록 테이블 -->
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th width="20"></th>
            <th>상담 날짜</th>
            <th>학생명</th>
            <th>학년</th>
            <th>상담 분류</th>
            <th>상담자</th>
            <th>상담 방법</th>
            <th>상태</th>
            <th>추가 상담</th>
            <th>액션</th>
          </tr>
        </thead>
        <tbody id="consultationsList">
          <!-- 동적으로 생성됨 -->
        </tbody>
      </table>
    </div>

    <!-- 페이지네이션 -->
    <div class="pagination" id="pagination"></div>
  </div>

  <!-- 상담 추가/수정 모달 -->
  <div id="consultationModal" class="modal">
    <div class="modal-content modal-large">
      <div class="modal-header">
        <h2 id="modalTitle">상담 추가</h2>
        <span class="close">&times;</span>
      </div>
      <div class="modal-body">
        <form id="consultationForm">
          <div class="form-row">
            <div class="form-group">
              <label for="student_id">학생 *</label>
              <select id="student_id" name="student_id" class="form-control" required>
                <option value="">학생을 선택하세요</option>
                <!-- 동적으로 생성됨 -->
              </select>
            </div>
            <div class="form-group">
              <label for="category_id">상담 분류 *</label>
              <select id="category_id" name="category_id" class="form-control" required>
                <option value="">선택하세요</option>
                <!-- 동적으로 생성됨 -->
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="consultation_date">상담 날짜 *</label>
              <input type="date" id="consultation_date" name="consultation_date" class="form-control" required>
            </div>
            <div class="form-group">
              <label for="consultation_time">상담 시간</label>
              <input type="time" id="consultation_time" name="consultation_time" class="form-control">
            </div>
            <div class="form-group">
              <label for="consultation_method">상담 방법</label>
              <select id="consultation_method" name="consultation_method" class="form-control">
                <option value="대면">대면</option>
                <option value="전화">전화</option>
                <option value="앱">앱</option>
                <option value="기타">기타</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="consultation_purpose">상담 목적</label>
            <input type="text" id="consultation_purpose" name="consultation_purpose" class="form-control" placeholder="예: 성적 향상 방안 논의">
          </div>
          <div class="form-group">
            <label for="consultation_content">상담 내용 *</label>
            <textarea id="consultation_content" name="consultation_content" class="form-control" rows="5" required></textarea>
          </div>
          <div class="form-group">
            <label for="consultation_result">처리 결과</label>
            <textarea id="consultation_result" name="consultation_result" class="form-control" rows="3"></textarea>
          </div>
          <div class="form-group">
            <label for="parent_feedback">학부모 피드백</label>
            <textarea id="parent_feedback" name="parent_feedback" class="form-control" rows="2"></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" id="follow_up_required" name="follow_up_required">
                추가 상담 필요
              </label>
            </div>
            <div class="form-group">
              <label for="follow_up_date">추가 상담 예정일</label>
              <input type="date" id="follow_up_date" name="follow_up_date" class="form-control">
            </div>
            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" id="is_important" name="is_important">
                중요 상담
              </label>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal()">취소</button>
        <button type="button" class="btn btn-primary" onclick="saveConsultation()">저장</button>
      </div>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/consultation/records.js"></script>
</body>
</html>