<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>수업 일정 - 클래빗</title>
    <link rel="stylesheet" href="/css/design-system.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/class-management.css">
</head>
<body>
    <%- include('../components/sidebar-menu', { academyName, page, userName }) %>

    <div class="container">
        <div class="page-header">
            <h1>수업 일정</h1>
            <div class="page-actions">
                <button id="todaySchedulesBtn" class="btn btn-secondary">오늘 일정</button>
                <button id="createScheduleBtn" class="btn btn-primary">
                    <span>+</span> 일정 추가
                </button>
            </div>
        </div>

        <!-- 필터 영역 -->
        <div class="filter-section">
            <div class="filter-group">
                <select id="classFilter" class="form-control">
                    <option value="">모든 클래스</option>
                </select>

                <select id="teacherFilter" class="form-control">
                    <option value="">모든 선생님</option>
                </select>

                <select id="statusFilter" class="form-control">
                    <option value="">모든 상태</option>
                    <option value="scheduled">예정</option>
                    <option value="ongoing">진행중</option>
                    <option value="completed">완료</option>
                    <option value="cancelled">취소</option>
                </select>

                <input type="date" id="startDate" class="form-control">
                <input type="date" id="endDate" class="form-control">
                <button id="filterBtn" class="btn btn-secondary">검색</button>
            </div>
        </div>

        <!-- 일정 목록/캘린더 뷰 전환 -->
        <div class="view-toggle">
            <button id="listViewBtn" class="btn btn-sm active">목록</button>
            <button id="calendarViewBtn" class="btn btn-sm">캘린더</button>
        </div>

        <!-- 일정 목록 -->
        <div id="schedulesList" class="schedules-list">
            <!-- 일정 항목들이 동적으로 로드됩니다 -->
        </div>

        <!-- 캘린더 뷰 -->
        <div id="calendarView" class="calendar-view" style="display: none;">
            <div id="calendar"></div>
        </div>

        <!-- 페이지네이션 -->
        <div id="pagination" class="pagination"></div>
    </div>

    <!-- 일정 생성/수정 모달 -->
    <div id="scheduleModal" class="modal">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h2 id="modalTitle">수업 일정 추가</h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <form id="scheduleForm">
                    <input type="hidden" id="scheduleId">

                    <div class="form-row">
                        <div class="form-group">
                            <label for="class_id">클래스</label>
                            <select id="class_id" class="form-control">
                                <option value="">선택 안함</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="teacher_id">담당 선생님</label>
                            <select id="teacher_id" class="form-control">
                                <option value="">선택하세요</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="subject">과목 *</label>
                            <input type="text" id="subject" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="room">강의실</label>
                            <input type="text" id="room" class="form-control">
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="title">수업 제목 *</label>
                        <input type="text" id="title" class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label for="description">수업 설명</label>
                        <textarea id="description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="schedule_date">날짜 *</label>
                            <input type="date" id="schedule_date" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="start_time">시작 시간 *</label>
                            <input type="time" id="start_time" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label for="end_time">종료 시간 *</label>
                            <input type="time" id="end_time" class="form-control" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="max_students">최대 인원</label>
                        <input type="number" id="max_students" class="form-control" min="1">
                    </div>

                    <div class="form-group">
                        <label>
                            <input type="checkbox" id="is_recurring">
                            반복 일정
                        </label>
                    </div>

                    <div id="recurringOptions" style="display: none;">
                        <div class="form-group">
                            <label>반복 유형</label>
                            <select id="recurring_type" class="form-control">
                                <option value="daily">매일</option>
                                <option value="weekly">매주</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="recurring_end_date">반복 종료일</label>
                            <input type="date" id="recurring_end_date" class="form-control">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary modal-close">취소</button>
                <button type="button" id="saveScheduleBtn" class="btn btn-primary">저장</button>
            </div>
        </div>
    </div>

    <!-- 일정 상세 모달 -->
    <div id="scheduleDetailModal" class="modal">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h2 id="detailTitle"></h2>
                <button class="modal-close">&times;</button>
            </div>
            <div class="modal-body">
                <div id="scheduleDetailContent"></div>

                <h3>참여 학생 (<span id="studentCount">0</span>명)</h3>
                <div id="studentsList" class="students-list"></div>

                <h3>출석 체크</h3>
                <div id="attendanceSection"></div>

                <h3>수업 자료</h3>
                <div id="materialsList"></div>

                <h3>과제</h3>
                <div id="assignmentsList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary modal-close">닫기</button>
                <button type="button" id="editScheduleBtn" class="btn btn-primary">수정</button>
                <button type="button" id="deleteScheduleBtn" class="btn btn-danger">삭제</button>
            </div>
        </div>
    </div>

    <script src="/js/common.js"></script>
    <script src="/js/api.js"></script>
    <script src="/js/class-management/schedules.js"></script>
</body>
</html>
