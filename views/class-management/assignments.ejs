<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>과제 관리 - 클래빗</title>
    <link rel="stylesheet" href="/css/design-system.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/class-management.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <%- include('../components/sidebar-menu', { academyName, page, userName }) %>

    <div class="container">
        <div class="page-header">
            <h1><i class="fas fa-tasks"></i> 과제 관리</h1>
            <div class="header-actions">
                <button id="createAssignmentBtn" class="btn btn-primary">
                    <i class="fas fa-plus"></i> 새 과제 만들기
                </button>
                <button id="templateBtn" class="btn btn-secondary">
                    <i class="fas fa-file-alt"></i> 템플릿
                </button>
            </div>
        </div>

        <!-- 뷰 모드 전환 (교사/학생) -->
        <% if (user.role === 'teacher' || user.role === 'admin') { %>
        <div class="view-mode-toggle">
            <button class="mode-btn active" data-mode="teacher">
                <i class="fas fa-chalkboard-teacher"></i> 교사 뷰
            </button>
            <button class="mode-btn" data-mode="student">
                <i class="fas fa-user-graduate"></i> 학생 뷰
            </button>
        </div>
        <% } %>

        <!-- 탭 네비게이션 -->
        <div class="tab-navigation">
            <button class="tab-btn active" data-tab="active">
                진행 중 <span class="badge" id="activeCount">0</span>
            </button>
            <button class="tab-btn" data-tab="upcoming">
                예정 <span class="badge" id="upcomingCount">0</span>
            </button>
            <button class="tab-btn" data-tab="completed">
                완료 <span class="badge" id="completedCount">0</span>
            </button>
            <button class="tab-btn" data-tab="drafts">
                임시저장 <span class="badge" id="draftsCount">0</span>
            </button>
        </div>

        <!-- 필터 섹션 -->
        <div class="filter-section">
            <div class="filter-group">
                <select id="classFilter" class="form-control">
                    <option value="">전체 반</option>
                </select>
                <select id="subjectFilter" class="form-control">
                    <option value="">전체 과목</option>
                    <option value="korean">국어</option>
                    <option value="english">영어</option>
                    <option value="math">수학</option>
                    <option value="science">과학</option>
                    <option value="social">사회</option>
                </select>
                <select id="statusFilter" class="form-control">
                    <option value="">전체 상태</option>
                    <option value="not_submitted">미제출</option>
                    <option value="submitted">제출 완료</option>
                    <option value="graded">채점 완료</option>
                    <option value="returned">반환됨</option>
                </select>
            </div>
            <div class="search-group">
                <div class="input-group">
                    <input type="text" id="searchInput" class="form-control" placeholder="과제 검색...">
                    <button id="searchBtn" class="btn btn-secondary">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- 과제 목록 -->
        <div id="assignmentsContainer" class="assignments-list">
            <!-- JavaScript로 동적 생성 -->
        </div>

        <!-- 페이지네이션 -->
        <div class="pagination" id="pagination"></div>
    </div>

    <!-- 과제 생성/수정 모달 -->
    <div id="assignmentModal" class="modal">
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h2 id="modalTitle">새 과제 만들기</h2>
                <button class="close-btn">&times;</button>
            </div>
            <div class="modal-body">
                <form id="assignmentForm">
                    <div class="form-row">
                        <div class="form-group col-md-8">
                            <label for="title">과제 제목</label>
                            <input type="text" id="title" class="form-control" required>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="subject">과목</label>
                            <select id="subject" class="form-control" required>
                                <option value="">선택하세요</option>
                                <option value="korean">국어</option>
                                <option value="english">영어</option>
                                <option value="math">수학</option>
                                <option value="science">과학</option>
                                <option value="social">사회</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="description">과제 설명</label>
                        <div id="descriptionEditor" class="rich-editor"></div>
                        <textarea id="description" style="display: none;"></textarea>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="targetType">대상 유형</label>
                            <select id="targetType" class="form-control">
                                <option value="class">반 전체</option>
                                <option value="individual">개별 학생</option>
                                <option value="group">그룹</option>
                            </select>
                        </div>
                        <div class="form-group col-md-6">
                            <label for="targets">대상 선택</label>
                            <select id="targets" class="form-control" multiple>
                                <!-- 동적 생성 -->
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label for="startDate">시작일</label>
                            <input type="datetime-local" id="startDate" class="form-control" required>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="dueDate">마감일</label>
                            <input type="datetime-local" id="dueDate" class="form-control" required>
                        </div>
                        <div class="form-group col-md-4">
                            <label for="maxScore">만점</label>
                            <input type="number" id="maxScore" class="form-control" value="100" min="1">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>첨부 파일</label>
                        <div class="file-upload-area">
                            <input type="file" id="attachments" multiple style="display: none;">
                            <button type="button" class="btn btn-secondary" onclick="document.getElementById('attachments').click()">
                                <i class="fas fa-paperclip"></i> 파일 첨부
                            </button>
                            <div id="attachmentList" class="attachment-list"></div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>과제 옵션</label>
                        <div class="checkbox-group">
                            <label>
                                <input type="checkbox" id="allowLateSubmission">
                                지각 제출 허용
                            </label>
                            <label>
                                <input type="checkbox" id="allowResubmission">
                                재제출 허용
                            </label>
                            <label>
                                <input type="checkbox" id="notifyParents">
                                학부모 알림
                            </label>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" id="saveDraftBtn">임시저장</button>
                        <button type="button" class="btn btn-secondary" onclick="closeModal()">취소</button>
                        <button type="submit" class="btn btn-primary">과제 생성</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 제출 상세 모달 (교사용) -->
    <div id="submissionModal" class="modal">
        <div class="modal-content modal-large">
            <div class="modal-header">
                <h2>제출 내역</h2>
                <button class="close-btn">&times;</button>
            </div>
            <div class="modal-body">
                <div class="submission-info">
                    <div class="info-row">
                        <span class="label">학생:</span>
                        <span id="submissionStudent"></span>
                    </div>
                    <div class="info-row">
                        <span class="label">제출 시간:</span>
                        <span id="submissionTime"></span>
                    </div>
                    <div class="info-row">
                        <span class="label">상태:</span>
                        <span id="submissionStatus" class="status-badge"></span>
                    </div>
                </div>

                <div class="submission-content">
                    <h3>제출 내용</h3>
                    <div id="submissionText"></div>
                    <div id="submissionFiles" class="file-list"></div>
                </div>

                <div class="grading-section">
                    <h3>채점 및 피드백</h3>
                    <form id="gradingForm">
                        <div class="form-row">
                            <div class="form-group col-md-4">
                                <label for="score">점수</label>
                                <input type="number" id="score" class="form-control" min="0">
                            </div>
                            <div class="form-group col-md-8">
                                <label for="feedback">피드백</label>
                                <textarea id="feedback" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">채점 완료</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 과제 제출 모달 (학생용) -->
    <div id="submitModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>과제 제출</h2>
                <button class="close-btn">&times;</button>
            </div>
            <div class="modal-body">
                <form id="submitForm">
                    <div class="assignment-info">
                        <h3 id="submitAssignmentTitle"></h3>
                        <div class="info-row">
                            <span class="label">마감일:</span>
                            <span id="submitDueDate"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="submissionText">답안 작성</label>
                        <textarea id="submissionText" class="form-control" rows="10"></textarea>
                    </div>

                    <div class="form-group">
                        <label>파일 첨부</label>
                        <div class="file-upload-area">
                            <input type="file" id="submissionFiles" multiple style="display: none;">
                            <button type="button" class="btn btn-secondary"
                                    onclick="document.getElementById('submissionFiles').click()">
                                <i class="fas fa-upload"></i> 파일 선택
                            </button>
                            <div id="submissionFileList" class="file-list"></div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" onclick="closeModal()">취소</button>
                        <button type="submit" class="btn btn-primary">제출</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 통계 모달 -->
    <div id="statsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>과제 통계</h2>
                <button class="close-btn">&times;</button>
            </div>
            <div class="modal-body">
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3>제출 현황</h3>
                        <canvas id="submissionChart"></canvas>
                    </div>
                    <div class="stat-card">
                        <h3>점수 분포</h3>
                        <canvas id="scoreChart"></canvas>
                    </div>
                </div>
                <div class="student-list">
                    <h3>학생별 제출 현황</h3>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>학생</th>
                                <th>제출 상태</th>
                                <th>점수</th>
                                <th>제출 시간</th>
                            </tr>
                        </thead>
                        <tbody id="studentStatusList">
                            <!-- 동적 생성 -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/common.js"></script>
    <script src="/js/class-management/assignments.js"></script>
</body>
</html>