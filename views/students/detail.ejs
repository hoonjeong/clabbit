<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Pretendard:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/design-system.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/students.css">
</head>
<body>
    <%- include('../components/sidebar-menu', { academyName, page: 'students', userName: userName }) %>

    <main class="students-main">
        <div class="students-container">
            <!-- 페이지 헤더 -->
            <div class="page-header">
                <h1 class="page-title">👤 학생 상세 정보</h1>
                <div style="display: flex; gap: 1rem;">
                    <a href="/students" class="back-btn">← 목록으로</a>
                </div>
            </div>

            <!-- 학생 상세 정보 -->
            <div class="student-detail" id="studentDetail">
                <!-- 로딩 상태 -->
                <div class="loading-state" id="loadingState">
                    <div class="loading-spinner"></div>
                    <p>학생 정보를 불러오는 중...</p>
                </div>

                <!-- 에러 상태 -->
                <div class="error-state" id="errorState" style="display: none;">
                    <div class="error-icon">⚠️</div>
                    <h3>학생 정보를 불러올 수 없습니다</h3>
                    <p id="errorMessage"></p>
                    <a href="/students" class="btn btn-primary">← 목록으로 돌아가기</a>
                </div>

                <!-- 학생 정보 표시 -->
                <div id="studentInfo" style="display: none;">
                    <!-- 액션 버튼 -->
                    <div class="detail-actions">
                        <button class="btn btn-primary" id="enrollBtn">📚 수업등록</button>
                        <button class="btn btn-outline" id="editBtn">✏️ 수정</button>
                        <button class="btn btn-secondary" id="cancelEditBtn" style="display: none;">취소</button>
                        <button class="btn btn-primary" id="saveBtn" style="display: none;">💾 저장</button>
                        <button class="btn btn-danger" id="withdrawBtn">퇴원 처리</button>
                    </div>

                    <!-- 학생 정보 폼 -->
                    <form id="studentForm">
                        <!-- 기본 정보 -->
                        <div class="form-section">
                            <h3 class="form-section-title">기본 정보</h3>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="name" class="form-label required">학생 이름</label>
                                    <input type="text" id="name" name="name" class="form-input" disabled maxlength="50">
                                    <span class="form-error" id="nameError"></span>
                                </div>

                                <div class="form-group">
                                    <label for="birth_date" class="form-label required">생년월일</label>
                                    <input type="date" id="birth_date" name="birth_date" class="form-input" disabled>
                                    <span class="form-error" id="birthDateError"></span>
                                </div>

                                <div class="form-group">
                                    <label for="school" class="form-label">학교</label>
                                    <input type="text" id="school" name="school" class="form-input" disabled maxlength="100">
                                </div>

                                <div class="form-group">
                                    <label for="grade" class="form-label">학년</label>
                                    <select id="grade" name="grade" class="form-select" disabled>
                                        <option value="">선택하세요</option>
                                        <option value="초등 1학년">초등 1학년</option>
                                        <option value="초등 2학년">초등 2학년</option>
                                        <option value="초등 3학년">초등 3학년</option>
                                        <option value="초등 4학년">초등 4학년</option>
                                        <option value="초등 5학년">초등 5학년</option>
                                        <option value="초등 6학년">초등 6학년</option>
                                        <option value="중학교 1학년">중학교 1학년</option>
                                        <option value="중학교 2학년">중학교 2학년</option>
                                        <option value="중학교 3학년">중학교 3학년</option>
                                        <option value="고등학교 1학년">고등학교 1학년</option>
                                        <option value="고등학교 2학년">고등학교 2학년</option>
                                        <option value="고등학교 3학년">고등학교 3학년</option>
                                        <option value="재수생">재수생</option>
                                        <option value="기타">기타</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="enrollment_type" class="form-label">등록 구분</label>
                                    <div class="radio-group" style="display: flex; gap: 20px; margin-top: 8px;">
                                        <label class="radio-label" style="display: flex; align-items: center; cursor: pointer;">
                                            <input type="radio" id="enrollment_type_new" name="enrollment_type" value="new" disabled style="margin-right: 6px;">
                                            <span style="font-size: 14px;">신규 등록</span>
                                        </label>
                                        <label class="radio-label" style="display: flex; align-items: center; cursor: pointer;">
                                            <input type="radio" id="enrollment_type_returning" name="enrollment_type" value="returning" disabled style="margin-right: 6px;">
                                            <span style="font-size: 14px;">재원 (복귀)</span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 연락처 정보 -->
                        <div class="form-section">
                            <h3 class="form-section-title">연락처 정보</h3>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="student_phone" class="form-label">학생 전화번호</label>
                                    <input type="tel" id="student_phone" name="student_phone" class="form-input" placeholder="010-1234-5678" disabled>
                                    <span class="form-error" id="studentPhoneError"></span>
                                </div>

                                <div class="form-group">
                                    <label for="parent_phone" class="form-label required">학부모 전화번호</label>
                                    <input type="tel" id="parent_phone" name="parent_phone" class="form-input" placeholder="010-1234-5678" disabled>
                                    <span class="form-error" id="parentPhoneError"></span>
                                </div>

                                <div class="form-group full-width">
                                    <label for="address" class="form-label">주소</label>
                                    <input type="text" id="address" name="address" class="form-input" disabled maxlength="500">
                                </div>
                            </div>
                        </div>

                        <!-- 메모 -->
                        <div class="form-section">
                            <h3 class="form-section-title">메모</h3>
                            <div class="form-group">
                                <label for="memo" class="form-label">메모</label>
                                <textarea id="memo" name="memo" class="form-textarea" placeholder="특이사항이나 기타 메모를 입력하세요" disabled maxlength="1000"></textarea>
                            </div>
                        </div>

                        <!-- 원생 상태 정보 -->
                        <div class="form-section">
                            <h3 class="form-section-title">원생 상태</h3>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label class="form-label">가입일</label>
                                    <div class="form-display" id="enrollmentDate">-</div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">상태</label>
                                    <div class="form-display">
                                        <span class="status-badge" id="statusBadge">재원</span>
                                    </div>
                                </div>

                                <div class="form-group" id="withdrawalDateGroup" style="display: none;">
                                    <label class="form-label">퇴원일</label>
                                    <div class="form-display" id="withdrawalDate">-</div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <script>
        const studentId = '<%= studentId %>';
    </script>
    <script src="/js/navigation.js"></script>
    <script src="/js/students/detail.js"></script>
</body>
</html>
